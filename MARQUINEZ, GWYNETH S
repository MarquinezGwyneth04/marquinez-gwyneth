# Grocery Stock Application System with SQLite Database
# Made with tkinter, ttk, messagebox, and sqlite3 only

import tkinter as tk
from tkinter import ttk, messagebox
import sqlite3
import os
from datetime import datetime

LOW_STOCK_LIMIT = 5
DB_FILE = "grocery_stock.db"
BACKUP_DIR = "backups"


class GroceryStockApp:
    def __init__(self, root):
        self.root = root
        self.root.title("🛒 Grocery Stock Management System")
        self.root.geometry("950x650")
        self.root.resizable(False, False)

        # Login state
        self.logged_in = False
        self.current_user = None

        # Connect database
        self.conn = sqlite3.connect(DB_FILE)
        self.cursor = self.conn.cursor()
        self.create_tables()

        # Create backup directory
        os.makedirs(BACKUP_DIR, exist_ok=True)

        # Show login window first
        self.show_login_window()

    def create_tables(self):
        # Users table
        self.cursor.execute("""
                            CREATE TABLE IF NOT EXISTS users
                            (
                                id
                                INTEGER
                                PRIMARY
                                KEY
                                AUTOINCREMENT,
                                username
                                TEXT
                                UNIQUE
                                NOT
                                NULL,
                                password
                                TEXT
                                NOT
                                NULL
                            )
                            """)
        # Add default admin user if not exists
        self.cursor.execute("SELECT COUNT(*) FROM users WHERE username='admin'")
        if self.cursor.fetchone()[0] == 0:
            self.cursor.execute("INSERT INTO users (username, password) VALUES (?, ?)",
                                ('admin', 'admin123'))
        self.conn.commit()

        # Grocery table
        self.cursor.execute("""
                            CREATE TABLE IF NOT EXISTS grocery
                            (
                                id
                                INTEGER
                                PRIMARY
                                KEY
                                AUTOINCREMENT,
                                name
                                TEXT,
                                category
                                TEXT,
                                quantity
                                INTEGER,
                                price
                                REAL
                            )
                            """)
        self.conn.commit()

    def auto_backup(self):
        """Automatic backup using sqlite3 backup API"""
        try:
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            backup_file = os.path.join(BACKUP_DIR, f"{DB_FILE.replace('.db', '')}_backup_{timestamp}.db")

            # Create backup using sqlite3 backup API (safe even with active connections)
            backup_conn = sqlite3.connect(backup_file)
            self.conn.backup(backup_conn)
            backup_conn.close()

            return backup_file
        except Exception as e:
            messagebox.showerror("Auto-backup Error", f"Failed to create auto-backup: {str(e)}")
            return None

    def manual_backup(self):
        """Manual backup with user confirmation"""
        if not self.logged_in:
            messagebox.showwarning("Access Denied", "Please login first.")
            return

        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        backup_file = os.path.join(BACKUP_DIR, f"{DB_FILE.replace('.db', '')}_manual_{timestamp}.db")

        try:
            backup_conn = sqlite3.connect(backup_file)
            self.conn.backup(backup_conn)
            backup_conn.close()
            messagebox.showinfo("Backup Success", f"Manual backup created:\n{backup_file}")
        except Exception as e:
            messagebox.showerror("Backup Error", f"Failed to create backup:\n{str(e)}")

    def generate_report(self):
        """Generate formatted text report (PDF-like)"""
        if not self.logged_in:
            messagebox.showwarning("Access Denied", "Please login first.")
            return

            # Get current data
        self.cursor.execute("SELECT name, category, quantity, price FROM grocery ORDER BY name")
        items = self.cursor.fetchall()

        if not items:
            messagebox.showinfo("No Data", "No inventory data to report.")
            return

            # Create formatted report
        report = []
        report.append("=" * 80)
        report.append(f"🛒 GROCERY STOCK REPORT")
        report.append(f"Generated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
        report.append(f"User: {self.current_user}")
        report.append(f"Total Items: {len(items)}")
        report.append("=" * 80)
        report.append(f"{'ITEM NAME':<25} {'CATEGORY':<15} {'QTY':<6} {'PRICE':<10} {'TOTAL':<12}")
        report.append("-" * 80)

        total_value = 0.0
        low_stock_items = []

        for item in items:
            name, category, qty, price = item
            total = qty * price
            total_value += total
            if qty <= LOW_STOCK_LIMIT:
                low_stock_items.append(name)
            report.append(f"{name[:24]:<25} {category[:14]:<15} {qty:<6} ₱{price:<9.2f} ₱{total:<11.2f}")

        report.append("-" * 80)
        report.append(f"TOTAL INVENTORY VALUE: ₱{total_value:,.2f}")
        if low_stock_items:
            report.append(f"⚠ LOW STOCK ({len(low_stock_items)} items): {', '.join(low_stock_items[:5])}" +
                          (f" and {len(low_stock_items) - 5} more..." if len(low_stock_items) > 5 else ""))
        report.append("=" * 80)
        report.append("Generated by Grocery Stock Management System")
        report.append("=" * 80)

        # Save report
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        report_file = f"stock_report_{timestamp}.txt"

        try:
            with open(report_file, 'w', encoding='utf-8') as f:
                f.write('\n'.join(report))
            messagebox.showinfo("Report Generated",
                                f"📊 Stock Report saved as:\n**{report_file}**\n\n"
                                f"💰 Total Value: ₱{total_value:,.2f}\n"
                                f"⚠ Low Stock: {len(low_stock_items)} items")
            os.startfile(report_file)  # Opens the file (Windows)
        except Exception as e:
            messagebox.showerror("Report Error", f"Failed to save report:\n{str(e)}")

            # [Previous methods remain the same - login, logout, create_user_window, etc.]

    def show_login_window(self):
        """Show login window and hide main app"""
        for widget in self.root.winfo_children():
            widget.destroy()

        login_frame = tk.Frame(self.root, bg="#f0f0f0")
        login_frame.pack(expand=True, fill="both", padx=50, pady=50)

        title = tk.Label(login_frame, text="🔐 Login Required", font=("Arial", 24, "bold"),
                         bg="#f0f0f0", fg="#333")
        title.pack(pady=30)

        cred_frame = tk.Frame(login_frame, bg="#f0f0f0")
        cred_frame.pack(pady=20)

        tk.Label(cred_frame, text="Username:", font=("Arial", 12), bg="#f0f0f0").grid(row=0, column=0, pady=10,
                                                                                      sticky="e")
        self.login_username = tk.Entry(cred_frame, font=("Arial", 12), width=20)
        self.login_username.grid(row=0, column=1, padx=10, pady=10)
        self.login_username.insert(0, "admin")

        tk.Label(cred_frame, text="Password:", font=("Arial", 12), bg="#f0f0f0").grid(row=1, column=0, pady=10,
                                                                                      sticky="e")
        self.login_password = tk.Entry(cred_frame, font=("Arial", 12), width=20, show="*")
        self.login_password.grid(row=1, column=1, padx=10, pady=10)
        self.login_password.insert(0, "admin123")

        btn_frame = tk.Frame(login_frame, bg="#f0f0f0")
        btn_frame.pack(pady=30)

        ttk.Button(btn_frame, text="Login", command=self.login).pack(side="left", padx=10)
        ttk.Button(btn_frame, text="Create User", command=self.create_user_window).pack(side="left", padx=10)

    def login(self):
        username = self.login_username.get().strip()
        password = self.login_password.get().strip()

        if not username or not password:
            messagebox.showerror("Login Error", "Please enter both username and password.")
            return

        self.cursor.execute("SELECT id FROM users WHERE username=? AND password=?", (username, password))
        user = self.cursor.fetchone()

        if user:
            self.logged_in = True
            self.current_user = username
            # Auto-backup on successful login
            self.auto_backup()
            self.show_main_app()
            messagebox.showinfo("Login Success", f"Welcome, {username}!\n✅ Auto-backup created.")
        else:
            messagebox.showerror("Login Failed", "Invalid username or password.\nDefault: admin/admin123")

    def logout(self):
        self.logged_in = False
        self.current_user = None
        self.show_login_window()
        messagebox.showinfo("Logged Out", "You have been logged out successfully.")

    def create_user_window(self):
        self.create_window = tk.Toplevel(self.root)
        self.create_window.title("Create New User")
        self.create_window.geometry("400x300")
        self.create_window.resizable(False, False)
        self.create_window.transient(self.root)
        self.create_window.grab_set()

        tk.Label(self.create_window, text="Create New User", font=("Arial", 16, "bold")).pack(pady=20)

        frame = tk.Frame(self.create_window)
        frame.pack(pady=20)

        tk.Label(frame, text="Username:").grid(row=0, column=0, sticky="e", padx=10, pady=10)
        self.new_username = tk.Entry(frame, width=25)
        self.new_username.grid(row=0, column=1, padx=10, pady=10)

        tk.Label(frame, text="Password:").grid(row=1, column=0, sticky="e", padx=10, pady=10)
        self.new_password = tk.Entry(frame, width=25, show="*")
        self.new_password.grid(row=1, column=1, padx=10, pady=10)

        btn_frame = tk.Frame(self.create_window)
        btn_frame.pack(pady=20)
        ttk.Button(btn_frame, text="Create", command=self.create_user).pack(side="left", padx=10)
        ttk.Button(btn_frame, text="Cancel", command=self.create_window.destroy).pack(side="left", padx=10)

    def create_user(self):
        username = self.new_username.get().strip()
        password = self.new_password.get().strip()

        if not username or not password:
            messagebox.showerror("Error", "Please fill both fields.")
            return

        try:
            self.cursor.execute("INSERT INTO users (username, password) VALUES (?, ?)", (username, password))
            self.conn.commit()
            messagebox.showinfo("Success", "User created successfully!")
            self.create_window.destroy()
        except sqlite3.IntegrityError:
            messagebox.showerror("Error", "Username already exists.")

