    def add_item(self):
        if not self.logged_in:
            messagebox.showwarning("Access Denied", "Please login first.")
            return
        name = self.item_name.get().strip()
        cat = self.category.get().strip()
        qty = self.quantity.get().strip()
        price = self.price.get().strip()

        if not name or not cat or not qty or not price:
            messagebox.showwarning("Input Error", "Please fill out all fields.")
            return
        try:
            qty = int(qty)
            price = float(price)
        except ValueError:
            messagebox.showerror("Invalid Input", "Quantity and Price must be numeric.")
            return

        self.cursor.execute("INSERT INTO grocery (name, category, quantity, price) VALUES (?, ?, ?, ?)",
                            (name, cat, qty, price))
        self.conn.commit()
        self.load_data()
        self.clear_fields()
        messagebox.showinfo("Success", "Item added successfully!")
        self.check_low_stock()

    def update_item(self):
        if not self.logged_in:
            messagebox.showwarning("Access Denied", "Please login first.")
            return
        selected = self.tree.selection()
        if not selected:
            messagebox.showwarning("Select Item", "Please select an item to update.")
            return

        item_id = self.tree.item(selected[0])["values"][0]
        try:
            qty = int(self.quantity.get())
            price = float(self.price.get())
        except ValueError:
            messagebox.showerror("Invalid Input", "Quantity and Price must be numeric.")
            return

        self.cursor.execute("UPDATE grocery SET name=?, category=?, quantity=?, price=? WHERE id=?",
                            (self.item_name.get(), self.category.get(), qty, price, item_id))
        self.conn.commit()
        self.load_data()
        self.clear_fields()
        messagebox.showinfo("Updated", "Item updated successfully!")
        self.check_low_stock()

    def delete_item(self):
        if not self.logged_in:
            messagebox.showwarning("Access Denied", "Please login first.")
            return
        selected = self.tree.selection()
        if not selected:
            messagebox.showwarning("Select Item", "Please select an item to delete.")
            return
        item_id = self.tree.item(selected[0])["values"][0]
        self.cursor.execute("DELETE FROM grocery WHERE id=?", (item_id,))
        self.conn.commit()
        self.load_data()
        messagebox.showinfo("Deleted", "Item deleted successfully!")
        self.check_low_stock()

    def clear_fields(self):
        self.item_name.delete(0, tk.END)
        self.category.delete(0, tk.END)
        self.quantity.delete(0, tk.END)
        self.price.delete(0, tk.END)

    def select_item(self, event):
        selected = self.tree.selection()
        if selected:
            item = self.tree.item(selected[0])["values"]
            self.item_name.delete(0, tk.END)
            self.item_name.insert(0, item[1])
            self.category.delete(0, tk.END)
            self.category.insert(0, item[2])
            self.quantity.delete(0, tk.END)
            self.quantity.insert(0, item[3])
            self.price.delete(0, tk.END)
            self.price.insert(0, item[4])

    def load_data(self):
        if not self.logged_in:
            return
        for row in self.tree.get_children():
            self.tree.delete(row)

        self.cursor.execute("SELECT * FROM grocery")
        rows = self.cursor.fetchall()

        total_items = len(rows)
        total_qty = 0
        total_value = 0.0
        low_count = 0

        for r in rows:
            total = r[3] * r[4]
            total_qty += r[3]
            total_value += total
            tag = ()
            if r[3] <= LOW_STOCK_LIMIT:
                tag = ("lowstock",)
                low_count += 1
            self.tree.insert("", tk.END, values=(r[0], r[1], r[2], r[3], r[4], f"{total:.2f}"), tags=tag)

        self.lbl_total_items.config(text=f"Total Items: {total_items}")
        self.lbl_total_qty.config(text=f"Total Quantity: {total_qty}")
        self.lbl_total_value.config(text=f"Total Value: ₱{total_value:.2f}")
        self.lbl_low_count.config(text=f"Low Stock: {low_count}")

    def search_item(self):
        if not self.logged_in:
            return
        keyword = self.search_var.get().lower()
        for row in self.tree.get_children():
            self.tree.delete(row)
        self.cursor.execute("SELECT * FROM grocery WHERE LOWER(name) LIKE ? OR LOWER(category) LIKE ?",
                            ('%' + keyword + '%', '%' + keyword + '%'))
        rows = self.cursor.fetchall()
        for r in rows:
            total = r[3] * r[4]
            tag = ()
            if r[3] <= LOW_STOCK_LIMIT:
                tag = ("lowstock",)
            self.tree.insert("", tk.END, values=(r[0], r[1], r[2], r[3], r[4], f"{total:.2f}"), tags=tag)

    def show_total_value(self):
        if not self.logged_in:
            messagebox.showwarning("Access Denied", "Please login first.")
            return
        self.cursor.execute("SELECT SUM(quantity * price) FROM grocery")
        total_value = self.cursor.fetchone()[0]
        total_value = total_value if total_value else 0
        messagebox.showinfo("Total Stock Value", f"Total Stock Value: ₱{total_value:.2f}")

    def show_low_stock(self):
        if not self.logged_in:
            messagebox.showwarning("Access Denied", "Please login first.")
            return
        self.cursor.execute("SELECT name, quantity FROM grocery WHERE quantity <= ?", (LOW_STOCK_LIMIT,))
        low_stock = self.cursor.fetchall()
        if not low_stock:
            messagebox.showinfo("Low Stock", "No low stock items found.")
        else:
            message = "\n".join([f"{name} ({qty} pcs)" for name, qty in low_stock])
            messagebox.showwarning("Low Stock Items", f"The following items are running low:\n\n{message}")

    def check_low_stock(self):
        if not self.logged_in:
            return
        self.cursor.execute("SELECT name, quantity FROM grocery WHERE quantity <= ?", (LOW_STOCK_LIMIT,))
        low_stock = self.cursor.fetchall()
        if low_stock:
            try:
                self.root.bell()
            except Exception:
                pass
            message = "\n".join([f"{name} ({qty} pcs)" for name, qty in low_stock])
            messagebox.showwarning("⚠ Low Stock Alert", f"The following items are running low:\n\n{message}")

    def __del__(self):
        try:
            self.conn.close()
        except Exception:
            pass


if __name__ == "__main__":
    root = tk.Tk()
    app = GroceryStockApp(root)
    root.mainloop()