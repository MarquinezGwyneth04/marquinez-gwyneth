        ttk.Button(dash_frame, text="📊 Generate Report", command=self.generate_report).pack(side="right", padx=5)
        ttk.Button(dash_frame, text="🚪 Logout", command=self.logout).pack(side="right", padx=10)

        # Title
        title = tk.Label(self.root, text=f"🛒 Grocery Stock Management System - {self.current_user}",
                         font=("Arial", 20, "bold"), bg="#4CAF50", fg="white", pady=10)
        title.pack(fill=tk.X)

        # Input Frame (unchanged from your original)
        frame1 = tk.LabelFrame(self.root, text="Add / Update Item", font=("Arial", 12, "bold"), padx=10, pady=10)
        frame1.pack(fill="x", padx=20, pady=10)

