        self.lbl_total_qty = tk.Label(dash_frame, text="Total Quantity: 0", font=("Arial", 11, "bold"))
        self.lbl_total_qty.pack(side="left", padx=10)

        self.lbl_total_value = tk.Label(dash_frame, text="Total Value: ₱0.00", font=("Arial", 11, "bold"))
        self.lbl_total_value.pack(side="left", padx=10)

        self.lbl_low_count = tk.Label(dash_frame, text="Low Stock: 0", font=("Arial", 11, "bold"), fg="red")
        self.lbl_low_count.pack(side="left", padx=10)

