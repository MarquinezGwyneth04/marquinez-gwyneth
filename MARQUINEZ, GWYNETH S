        ttk.Button(btn_frame, text="Update Item", command=self.update_item).grid(row=0, column=1, padx=5)
        ttk.Button(btn_frame, text="Delete Item", command=self.delete_item).grid(row=0, column=2, padx=5)
        ttk.Button(btn_frame, text="Clear Fields", command=self.clear_fields).grid(row=0, column=3, padx=5)

        # Search Frame
        frame2 = tk.LabelFrame(self.root, text="Search / Analytics", font=("Arial", 12, "bold"), padx=10, pady=10)
        frame2.pack(fill="x", padx=20, pady=10)

        tk.Label(frame2, text="Search Item:", font=("Arial", 11)).grid(row=0, column=0, sticky="w", padx=5)
        self.search_var = tk.StringVar()
        tk.Entry(frame2, textvariable=self.search_var, width=30).grid(row=0, column=1, padx=5)
        ttk.Button(frame2, text="Search", command=self.search_item).grid(row=0, column=2, padx=5)
